{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PrivaCage Intelligence Bundle v2",
  "type": "object",
  "required": [
    "schema_version",
    "updated_at",
    "entities",
    "sdk_fingerprints",
    "sources",
    "entries",
    "app_fingerprints"
  ],
  "properties": {
    "schema_version": {
      "const": 2
    },
    "updated_at": {
      "type": "string",
      "format": "date"
    },
    "entities": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/entity"
      }
    },
    "sdk_fingerprints": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/sdk"
      }
    },
    "sources": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/evidence"
      }
    },
    "entries": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/entry"
      }
    },
    "app_fingerprints": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/app"
      }
    }
  },
  "$defs": {
    "evidence": {
      "type": "object",
      "required": [
        "url",
        "description"
      ],
      "properties": {
        "url": {
          "type": "string",
          "format": "uri"
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "retrieved_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date"
        },
        "source_type": {
          "type": [
            "string",
            "null"
          ]
        },
        "id": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "entity": {
      "type": "object",
      "required": [
        "id",
        "name",
        "entity_type"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "entity_type": {
          "enum": [
            "company",
            "subsidiary",
            "sdk_vendor",
            "service",
            "domain_owner",
            "certificate_owner",
            "unknown"
          ]
        },
        "parent_entity_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "domains": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "evidence_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "sdk": {
      "type": "object",
      "required": [
        "id",
        "name"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "package_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "dex_strings": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "file_hashes_sha256": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Fa-f0-9]{64}$"
          }
        },
        "entity_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "evidence_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "entry": {
      "type": "object",
      "required": [
        "id",
        "name",
        "category",
        "indicators",
        "status",
        "evidence"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "category": {
          "type": "string",
          "minLength": 1
        },
        "indicators": {
          "$ref": "#/$defs/indicators"
        },
        "status": {
          "enum": [
            "active",
            "review",
            "retired",
            "deprecated"
          ]
        },
        "confidence": {
          "enum": [
            "low",
            "medium",
            "high"
          ]
        },
        "last_verified": {
          "type": [
            "string",
            "null"
          ],
          "format": "date"
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/evidence"
          }
        },
        "entity_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "sdk_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "localized_names": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "app": {
      "type": "object",
      "required": [
        "id",
        "package_id"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "package_id": {
          "type": "string",
          "minLength": 1
        },
        "signing_certificate_sha256": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[A-Fa-f0-9]{64}$"
        },
        "sdk_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "evidence_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "indicators": {
      "type": "object",
      "properties": {
        "domains": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "ip_addresses": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "package_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "certificate_sha256": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Fa-f0-9]{64}$"
          }
        },
        "dex_strings": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "file_hashes_sha256": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Fa-f0-9]{64}$"
          }
        },
        "sdk_patterns": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
