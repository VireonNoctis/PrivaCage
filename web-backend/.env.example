# Copy these values into the environment of the Rust API process.
# The backend does not load .env files automatically.

PRIVACAGE_WEB_BIND=127.0.0.1:8787

# Sliding-window API limit per observed client IP.
PRIVACAGE_RATE_LIMIT_REQUESTS=120
PRIVACAGE_RATE_LIMIT_WINDOW_SECONDS=60

# Comma-separated IP addresses of reverse proxies that overwrite X-Real-IP.
# Leave empty unless the API only receives traffic from a trusted proxy.
# Example for a local Nginx proxy: PRIVACAGE_TRUSTED_PROXY_IPS=127.0.0.1,::1
PRIVACAGE_TRUSTED_PROXY_IPS=
